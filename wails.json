{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "SafeNote",
  "outputfilename": "safenote",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "author": {
    "name": "sroctadian"
  },
   "Info": {
    "companyName": "SR Labs",
    "productName": "Safe Note",
    "productVersion": "0.1.6",
    "copyright": "srlabs",
    "comments": "An offline-first, encrypted note application."
  },
  "postBuildHooks": {
    "windows/amd64": "powershell -Command \"$v = (Get-Content ../../wails.json | ConvertFrom-Json).info.productVersion; Copy-Item safenote.exe safenote-v$v.exe -Force\""
  }
}
